# Copy to .env and add any free keys you have. All are optional.
# The agent runs in historical/demo mode with zero keys.

# https://www.football-data.org/client/register — free
FOOTBALL_DATA_ORG_KEY=

# https://dashboard.api-football.com — free, 100 req/day per sport API
API_SPORTS_KEY=

# https://the-odds-api.com — free, 500 credits/month
THE_ODDS_API_KEY=

# https://www.sportmonks.com — optional
SPORTMONKS_KEY=

# https://www.thesportsdb.com — optional
THESPORTSDB_KEY=
